# Editable binary art projects and high-dynamic-range textures belong in LFS.
# The checked-in GLB modules are deliberately small; their editable source is
# tools/art/build_corner.py. Larger exports must be moved to LFS before commit.
*.blend filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
